# Скопируй в .env (make env) и замени все change-me до первого make up.
COMPOSE_PROJECT_NAME=bitrix-lab
TZ=Europe/Moscow

# Пользователь хоста (id -u / id -g) — владелец файлов в ./www
UID=1000
GID=1000

PHP_VERSION=8.4.27

# --- Порты на 127.0.0.1 ---
HTTP_PORT=8080
MYSQL_PORT=3306
RABBITMQ_UI_PORT=15672
MEILI_PORT=7700
MAILPIT_UI_PORT=8025
MOCK_PORT=8090
KEYCLOAK_PORT=8180

# --- MySQL (данные для мастера установки Битрикса: сервер mysql) ---
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Кеш Битрикса (make settings); адреса сервисов заданы в docker-compose.yml ---
BX_CACHE_SID=bitrix-lab

# --- RabbitMQ ---
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=change-me

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-at-least-16-bytes

# --- Keycloak (профиль sso) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
